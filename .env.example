# Browser-safe Supabase configuration. Values are intentionally blank.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application origin, for example https://lms.example.invalid.
NEXT_PUBLIC_APP_URL=

# Server-only identity configuration. Never expose these with NEXT_PUBLIC_.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Keep Supabase signup disabled until its Azure provider uses the exact tenant
# URL, the xms_edov/email optional claims are configured, and the database
# institutional_auth_config row has been populated and explicitly enabled.

# Add a service-role key only in a package that owns a reviewed privileged use.
# SUPABASE_SERVICE_ROLE_KEY=
